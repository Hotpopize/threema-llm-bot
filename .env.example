# ---------------------------------------------------------------------------
# Threema Gateway Credentials (https://gateway.threema.ch)
# NOTE: Your Gateway ID must be configured in End-to-End (E2E) mode.
# ---------------------------------------------------------------------------
THREEMA_GATEWAY_ID=*YOUR_ID
THREEMA_GATEWAY_SECRET=your_gateway_api_secret_here
THREEMA_PRIVATE_KEY=private:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------------
# Option 1: OpenAI Cloud API
OPENAI_API_KEY=sk-proj-your_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Local OpenAI-compatible API (e.g. Ollama, LM Studio, vLLM)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=gemma3:4b
# LLM_API_KEY=ollama

# Bot Personality / Instructions
SYSTEM_PROMPT="You are a helpful, concise assistant replying via Threema. Keep responses clear and under 3,000 characters."

# ---------------------------------------------------------------------------
# Server & Tunnel Configuration
# ---------------------------------------------------------------------------
PORT=8080
MAX_CONCURRENT_LLM=4
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here
